# SQL Server Express connection from the supplied SSMS connection settings.
# Run data/sql/01_schema.sql first. Requires Microsoft ODBC Driver 18 for SQL Server.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3DBUIGIABAO%5CSQLEXPRESS%3BDATABASE%3DElearningSentiment%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes%3B

# Replace this value before deploying outside a local class demo.
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
SENTIMENT_MODEL_PATH=data/models/svm_tfidf.joblib
SENTIMENT_VECTORIZER_PATH=data/processed/vectorized/tfidf_vectorizer.joblib

# Optional SMTP settings for password reset emails. Without SMTP in development,
# the API returns a development_token for local demonstration only.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.edu
